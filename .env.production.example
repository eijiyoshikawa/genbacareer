# Production environment variables for genbacareer.jp

# App
NEXT_PUBLIC_BASE_URL=https://www.genbacareer.jp

# NextAuth
NEXTAUTH_URL=https://www.genbacareer.jp
NEXTAUTH_SECRET=

# Email (SendGrid)
EMAIL_FROM=noreply@genbacareer.jp
SENDGRID_API_KEY=

# Database (Supabase PostgreSQL)
DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Meilisearch
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# 本番運用が安定し prisma db push 済みなら "false" にすると、
# cold lambda で 40+ 件の ALTER TABLE / CREATE INDEX が走らなくなり TTFB が改善する。
# スキーマ変更を入れた直後は未設定 (= true) で 1〜2 回走らせて反映を確認すること。
ENSURE_SCHEMA=
