  @@index([industry, occupation], name: "idx_job_classification")
  @@map("job_category_classifications")
}

// ========================================
// クローラ差分同期 (7.2)
// ========================================
/// 外部ソース別の最終同期チェックポイント。
/// 次回クロール時に lastCursor / lastSyncedAt から差分のみ取り込む。
model CrawlerSyncCheckpoint {
  source         String   @id @db.VarChar(50) // hellowork | indeed | ...
  lastSyncedAt   DateTime @map("last_synced_at") @db.Timestamptz()
