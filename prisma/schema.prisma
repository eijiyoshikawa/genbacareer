// ========================================
// AI 生成記事 (9.7)
// ========================================
/// 13.1 ブログ / 13.2 地域×職種 LP の本文を LLM で
/// 補完生成。admin がレビューして published にする運用。
model AiGeneratedArticle {
  id            String    @id @default(uuid()) @db.Uuid
  slug          String    @unique @db.VarChar(200)
  topic         String    @db.VarChar(200) // 業界 + 職種 + 地域 等
  prompt        String
  bodyMarkdown  String    @map("body_markdown")
  status        String    @default("draft") @db.VarChar(20) // draft | review | published
