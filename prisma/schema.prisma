// ========================================
// 採用決定ボーナス (15.6)
// ========================================
/// 応募 → 採用決定時に求職者へ支払う祝い金 (現金 / Amazon ギフトカード / 振込)。
/// 申請から admin 承認・支払までのワークフローを記録。
model HiringBonus {
  id              String    @id @default(uuid()) @db.Uuid
  applicationId   String    @unique @map("application_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  amount          Int       // JPY
  payoutMethod    String    @map("payout_method") @db.VarChar(30) // amazon_gift | bank_transfer | cash
  payoutDetails   Json?     @map("payout_details") // 振込先 / メールアドレス等
  status          String    @default("requested") @db.VarChar(20) // requested | approved | paid | rejected
  requestNote     String?   @map("request_note")
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz()
  approvedBy      String?   @map("approved_by") @db.Uuid
  paidAt          DateTime? @map("paid_at") @db.Timestamptz()
  paidBy          String?   @map("paid_by") @db.Uuid
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz()
  rejectionReason String?   @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  // BillingEvent / EarlyResignation と異なり、これまで FK 制約が一切無く
  // 存在しない application/user/company を指す行を作成でき、参照先が
  // 消えても孤児化を検知できなかった。実際の申請フローは常に有効な
  // Application 経由 (users/me/hiring-bonuses) なので Cascade を付与する。
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)], name: "idx_hiring_bonuses_status")
  @@index([userId, createdAt(sort: Desc)], name: "idx_hiring_bonuses_user")
  @@map("hiring_bonuses")
}

// ========================================
// 早期退職 / 戻入処理 (C3, 2026-05 追加)
// ========================================
// 採用が成立した後、一定期間内 (3 ヶ月以内) に求職者が退職した場合、
// 企業が運営に支払った成果報酬の一部を返金 (credit note) する制度。
//
// 返金率:
//   入社 1 ヶ月以内: 80%
//   入社 2 ヶ月以内: 50%
//   入社 3 ヶ月以内: 20%
//   入社 4 ヶ月以降: 0% (返金対象外)
//
// 流れ:
//   1. 企業が /company/applications/[id] から退職を報告 → status=reported
//   2. admin が /admin/early-resignations で内容確認 → 承認 or 却下
//   3. 承認時、自動で MoneyForward に credit note (返金額計算済) を発行 → status=invoiced
model EarlyResignation {
  id               String   @id @default(uuid()) @db.Uuid
  applicationId    String   @unique @map("application_id") @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  jobId            String   @map("job_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid

  // 採用確定日のスナップショット (Application.hiredAt から)
  hiredAt          DateTime @map("hired_at") @db.Timestamptz()
  // 退職日 (求職者の最終出勤日)
  resignedAt       DateTime @map("resigned_at") @db.Timestamptz()
  // 経過月数 (1, 2, 3, 4+)。返金率計算に使う
  monthsAfterHire  Int      @map("months_after_hire")

  // 返金率 (80 / 50 / 20 / 0)。% 値そのまま保持
  refundRate       Int      @map("refund_rate")
  // 元の成果報酬額 (BillingEvent.amount のスナップショット、退職時の単価変動防止)
  originalFeeAmount Int     @map("original_fee_amount")
  // 返金額 (originalFeeAmount * refundRate / 100)
  refundAmount     Int      @map("refund_amount")

  // ステータス: reported(企業申請) | approved(admin 承認) | rejected(admin 却下) | invoiced(返金書発行済)
  status           String   @default("reported") @db.VarChar(20)

  // 企業のコメント (退職事情等)
  companyNote      String?  @map("company_note")
  // admin のコメント (承認 / 却下理由)
  adminNote        String?  @map("admin_note")

  // 申請者 (CompanyUser、削除時は NULL)
  reportedBy       String?  @map("reported_by") @db.Uuid
  // 承認者 (admin user、削除時は NULL)
  approvedBy       String?  @map("approved_by") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz()
  // 却下者
  rejectedBy       String?  @map("rejected_by") @db.Uuid
  rejectedAt       DateTime? @map("rejected_at") @db.Timestamptz()

  // MoneyForward に発行した credit note ID (連携できない場合は admin 手動で振込)
  mfCreditNoteId   String?  @map("mf_credit_note_id") @db.VarChar(100)
  invoicedAt       DateTime? @map("invoiced_at") @db.Timestamptz()

  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt(sort: Desc)], name: "idx_early_resignations_company")
  @@index([status, createdAt(sort: Desc)], name: "idx_early_resignations_status")
  @@map("early_resignations")
}

// ========================================
// Google Calendar 連携 (14.4)
// ========================================
/// 企業ごとに 1 件。OAuth で取得したリフレッシュトークン等を保管。
/// 面接日時 (Application.interviewAt) の保存時に該当企業の Google Calendar にイベントを作成/更新/削除する。
model CompanyCalendarOauth {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @unique @map("company_id") @db.Uuid
  email          String   @db.VarChar(255) // 連携先 Google アカウント
  refreshToken   String   @map("refresh_token")
  accessToken    String?  @map("access_token")
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz()
  scope          String   @default("") @db.VarChar(500)
  calendarId     String   @default("primary") @map("calendar_id") @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("company_calendar_oauth")
}

// ========================================
// 企業口コミ・レビュー (12.2)
// ========================================
/// 求職者が在籍/元在籍経験から企業を評価する口コミ。
/// admin モデレーションを通過したものだけ公開。
model CompanyReview {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid // 匿名投稿許可するため nullable
  // 雇用状態: current(現在在籍) / former(元従業員) / interview(面接のみ)
  employmentStatus String @map("employment_status") @db.VarChar(20)
  // 1-5 の総合星評価
  rating      Int
  // 詳細評価 (任意): 給与 / 働きやすさ / 成長 / 福利厚生
  ratingSalary       Int? @map("rating_salary")
  ratingWorkLife     Int? @map("rating_work_life")
  ratingGrowth       Int? @map("rating_growth")
  ratingBenefits     Int? @map("rating_benefits")
  // 自由記述 (3 セクション)
  title       String?  @db.VarChar(200)
  goodPoints  String?  @map("good_points") // 良い点
  badPoints   String?  @map("bad_points")  // 改善点
  advice      String?  // 入社を検討する人へのアドバイス
  // モデレーション: pending(審査中) / approved(公開) / rejected(非公開)
  status      String   @default("pending") @db.VarChar(20)
  // 表示名（ハンドル）。匿名なら "建設業界の方" 等
  displayName String?  @map("display_name") @db.VarChar(50)
  // 投稿時 IP (連投検知用)
  reporterIp  String?  @map("reporter_ip") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  // モデレーション結果
  moderatedAt   DateTime? @map("moderated_at") @db.Timestamptz()
  moderatedBy   String?   @map("moderated_by") @db.Uuid
  moderationNote String?  @map("moderation_note") @db.VarChar(500)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ログイン済みユーザーは同一企業への口コミを 1 件までに制限する（評価操作対策）。
  // userId は nullable（匿名投稿許可）で Postgres の UNIQUE は NULL 同士を
  // 別値扱いするため、匿名投稿同士は引き続き何件でも許可される。
  @@unique([companyId, userId])
  @@index([companyId, status, createdAt(sort: Desc)], name: "idx_company_reviews_by_company")
  @@index([status, createdAt(sort: Desc)], name: "idx_company_reviews_moderation")
  @@map("company_reviews")
}

// ========================================
// 気になる (ライト応募 12.3)
// ========================================
/// JobFavorite (お気に入り) より軽い意思表示。
/// 「気になる」と押すと企業側で「気になられた」リストに表示され、
/// 企業から「会いたい」アプローチを受けられる可能性がある。
model JobInterest {
  userId    String   @map("user_id") @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  // 企業が見たかどうか (既読フラグ)
  seenByCompanyAt DateTime? @map("seen_by_company_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@index([jobId, createdAt(sort: Desc)], name: "idx_job_interests_by_job")
  @@index([userId, createdAt(sort: Desc)], name: "idx_job_interests_by_user")
  @@map("job_interests")
}

// ========================================
// スカウトメッセージ (12.x): 企業 → 求職者の片方向メッセージ
// ========================================
/// 企業から求職者に送るスカウトメッセージ。
/// (companyId, jobId, userId) で実質 UNIQUE だが、期限切れ後の再送を許す
/// ため partial unique index を manual SQL で別途定義する
/// (status NOT IN ('expired','declined') の時のみ UNIQUE)。
model ScoutMessage {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  jobId         String   @map("job_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  // 送信担当者 (監査用)。
  // 注: CompanyUser との FK は未設定 (CompanyUser の削除経路が現状存在しないため)。
  // CompanyUser のハード削除を実装する場合は、ここに onDelete: SetNull の
  // @relation を追加すること（この列は無効な company_user_id を指せてしまう）。
  companyUserId String?  @map("company_user_id") @db.Uuid

  subject       String   @db.VarChar(120)
  body          String

  // sent → read (求職者が詳細を開いた) → expired (期限切れ) / declined (辞退)
  status        String   @default("sent") @db.VarChar(20)
  sentAt        DateTime @default(now()) @map("sent_at") @db.Timestamptz()
  readAt        DateTime? @map("read_at") @db.Timestamptz()
  expiresAt     DateTime @map("expires_at") @db.Timestamptz()
  // 通知メール配信成功時刻。null なら opt-out or 失敗
  emailSentAt   DateTime? @map("email_sent_at") @db.Timestamptz()
  declineReason String?  @map("decline_reason") @db.VarChar(200)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, sentAt(sort: Desc)], name: "idx_scouts_inbox")
  @@index([companyId, sentAt(sort: Desc)], name: "idx_scouts_outbox")
  @@index([expiresAt], name: "idx_scouts_expiry")
  @@map("scout_messages")
}

// ========================================
// 除外キーワード (8.1)
// ========================================
/// クローラ取り込み時の除外フィルタ。
/// keyword が job.title / description / company.name に含まれる
/// 求人を取り込みから除外する。admin が管理。
model Blocklist {
  id          String   @id @default(uuid()) @db.Uuid
  keyword     String   @db.VarChar(100)
  // 適用範囲: title | description | company | any (default any)
  scope       String   @default("any") @db.VarChar(20)
  // 説明 (なぜこの語をブロックするか)
  note        String?  @db.VarChar(500)
  // 有効/無効: 一時的にオフにしたい時のため
  enabled     Boolean  @default(true)
  // 実際に何件除外したかの累計
  hitCount    Int      @default(0) @map("hit_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy   String?  @map("created_by") @db.Uuid // admin user id

  @@index([enabled, scope], name: "idx_blocklist_enabled_scope")
  @@map("blocklists")
}

// ========================================
// アナリティクスイベント (13.4)
// ========================================
/// GA4 と並行して持つ独自イベントログ。
/// search / view_job / apply / interest_click / scout_click 等。
/// payload は Json で柔軟に。admin の /admin/analytics で可視化。
model AnalyticsEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  sessionId String?  @map("session_id") @db.VarChar(50)
  name      String   @db.VarChar(50) // search | view_job | apply | ...
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([name, createdAt(sort: Desc)], name: "idx_analytics_name_time")
  @@index([userId, createdAt(sort: Desc)], name: "idx_analytics_user_time")
  @@map("analytics_events")
}
