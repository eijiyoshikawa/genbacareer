  totalSkipped   Int      @default(0) @map("total_skipped")
  totalErrors    Int      @default(0) @map("total_errors")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("crawler_sync_checkpoints")
}

// ========================================
// Search Console スナップショット (9.6)
