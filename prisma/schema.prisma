// ========================================
// 通報・レポート (6.2)
// ========================================
/// 求人 / 企業 / ユーザー / 口コミ等への通報。
/// targetType + targetId のシンプル多態。reporterId は匿名通報 (null) も許可。
/// admin が status を resolved / dismissed に更新して処理。
model Report {
  id          String    @id @default(uuid()) @db.Uuid
  targetType  String    @map("target_type") @db.VarChar(20) // job | company | user | review
  targetId    String    @map("target_id") @db.Uuid
  reporterId  String?   @map("reporter_id") @db.Uuid
  reporterIp  String?   @map("reporter_ip") @db.VarChar(45)
  reason      String    @db.VarChar(100) // 規約違反 | 虚偽情報 | 不適切な表現 | 個人情報 | その他
  detail      String?
  status      String    @default("open") @db.VarChar(20) // open | resolved | dismissed
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz()
  resolvedBy  String?   @map("resolved_by") @db.Uuid // admin user id
  resolution  String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  reporter User? @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)], name: "idx_reports_status_time")
  @@index([targetType, targetId], name: "idx_reports_target")
  @@map("reports")
}

// ========================================
// クローラ求人のカテゴリ分類 (7.1)
