# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# App
NEXT_PUBLIC_BASE_URL="https://genbacareer.jp"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# LINE Login (optional)
LINE_CLIENT_ID=""
LINE_CLIENT_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (SendGrid). 未設定時は console.log にフォールバック
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@genbacareer.jp"
# 管理者宛通知（お問い合わせ受信時に転送される宛先）
CONTACT_ADMIN_EMAIL=""

# Supabase Storage（履歴書・ロゴアップロード用。未設定なら 503 を返す）
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"

# Cron Secret（/api/cron/* で Authorization: Bearer ${CRON_SECRET} を要求）
CRON_SECRET=""

# 特商法表記 / 運営者情報（/legal/tokushoho ページが参照）
NEXT_PUBLIC_SITE_OPERATOR=""
NEXT_PUBLIC_SITE_REPRESENTATIVE=""
NEXT_PUBLIC_SITE_ADDRESS=""
NEXT_PUBLIC_SITE_PHONE=""
NEXT_PUBLIC_SITE_CONTACT_EMAIL=""
